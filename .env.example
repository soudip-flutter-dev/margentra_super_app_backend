# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=MargNetra Super App
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALLOWED_HOSTS=*

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://margnetra:margnetra@localhost:5432/margnetra_db
SYNC_DATABASE_URL=postgresql://margnetra:margnetra@localhost:5432/margnetra_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AWS S3 / Compatible Object Storage ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=margnetra-storage
S3_ENDPOINT_URL=                    # leave blank for real AWS, set for MinIO etc.
USE_LOCAL_STORAGE=true              # set false to use S3

# ─── Email (for OTP / expiry alerts) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@margnetra.in
SMTP_PASSWORD=your-smtp-password
EMAILS_FROM_NAME=MargNetra

# ─── RTO / Vahan API ──────────────────────────────────────────────────────────
RTO_API_BASE_URL=https://api.vahan.nic.in/v1
RTO_API_KEY=your-rto-api-key

# ─── DigiLocker ───────────────────────────────────────────────────────────────
DIGILOCKER_CLIENT_ID=your-digilocker-client-id
DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_SOS=10/minute

# ─── MGC Wallet ───────────────────────────────────────────────────────────────
MGC_PER_KM_RATE=1.5
MGC_BONUS_STREAK_DAYS=7
MGC_STREAK_PROTECTION_COST=50
